# FastAPI Service Environment Variables

# Database (optional for v0.1.0, will be used in future versions)
DATABASE_URL=postgresql://user:password@localhost:5432/platepilot

# OpenAI API (will be used in v0.4.0 for exercise recommendations)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:19006
